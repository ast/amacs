use flake
PATH_add target/debug
# Keep trial runs away from a server that is already running.
export AMACS_SOCKET="$XDG_RUNTIME_DIR/amacs/dev.sock"
# A server that is started here, by `just restart` or by amacsclient, is
# set up by init.local.scm, which is not committed and holds what is
# private, if it is there, and else by the example init file: not by the
# one in ~/.config. Same as in the justfile.
if [ -f init.local.scm ]; then
    export AMACS_INIT="$PWD/init.local.scm"
else
    export AMACS_INIT="$PWD/examples/init.scm"
fi
